PORT=3001

# Supabase PostgreSQL
# Runtime connection — Supavisor transaction pooler (port 6543).
# Dashboard: Project Settings > Database > Connection string > Transaction pooler
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Migrations / introspection only — direct connection (port 5432).
# The pooler cannot run DDL in the way `prisma migrate` needs.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Base URL shown in the OpenAPI docs at /api/reference. Set to the deployed API URL
# (including the /api prefix) so generated curl snippets and "Test Request" work.
# PUBLIC_API_URL="https://your-api.example.com/api"

# Comma-separated list of browser origins allowed to call this API. Required in
# production — left unset, CORS falls back to allowing any origin, which is only
# acceptable while developing locally.
# CORS_ORIGIN="https://your-frontend.example.com"

# Optional: path to the Supabase CA certificate. Without it the connection is still
# encrypted, but the server certificate is not verified. Defaults to certs/supabase-ca.crt
# PG_SSL_ROOT_CERT="certs/supabase-ca.crt"

# Generate each one separately before deploying: `openssl rand -base64 48`.
# Anyone holding these can mint tokens for any account, so they must never be
# committed or reused between environments.
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES="7d"

# Supabase Storage — used for blog image uploads.
# Service role key: server-side only, never expose to the browser.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
SUPABASE_BUCKET="blogs-images"
